* text=auto
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
# Preserve the archived plan byte-for-byte, including its original final newline.
docs/plan/** -text whitespace=-blank-at-eof
# Preserve the two migrated Windows work-log snapshots exactly.
docs/worklog/archive/2026-10-23-*.md -text whitespace=cr-at-eol
# Retain the upstream font license verbatim, including its one trailing space.
src/solarops/api/static/fonts/OFL.txt -text whitespace=-blank-at-eol
