SOLAROPS_DATA_DIR=data
# Native demo uses SQLite. Compose/kind use dedicated PostgreSQL and MinIO.
# SOLAROPS_DATABASE_URL=postgresql+psycopg://solarops:GENERATED@localhost:55432/solarops
# SOLAROPS_S3_ENDPOINT=http://localhost:59000
# SOLAROPS_S3_ACCESS_KEY=GENERATED
# SOLAROPS_S3_SECRET_KEY=GENERATED
SOLAROPS_S3_BUCKET=solarops-demo
SOLAROPS_ORG=demo
SOLAROPS_REPORT_TIMEZONE=UTC
SOLAROPS_SOURCE_DIR=data/source
# Compose: optional absolute path on the Docker host; mounted read-only at /source.
# SOLAROPS_SOURCE_HOST_DIR=/path/to/solarops-audit/data/source
